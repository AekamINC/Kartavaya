# Kartavya Backend — Environment Variables
# Copy to .env for local dev, set in Railway for production

# Supabase PostgreSQL direct connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.efzzjcnpjigeffkiissb.supabase.co:5432/postgres

# JWT — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-char-random-hex

# Field-level encryption at rest (employee Aadhaar, WhatsApp access tokens).
# Generate the same way as JWT_SECRET, and use a DIFFERENT value.
#
# Leave it unset and services/encryption.py falls back to JWT_SECRET, which
# works but ties every encrypted field to the auth secret: rotating JWT_SECRET
# then makes all of them permanently unreadable, with no error at rotation
# time and no symptom until someone opens a record. The fallback logs a warning
# for exactly this reason.
#
# Once data has been encrypted under it, this value must never change — there
# is no re-key path. Store it somewhere durable before you use it.
FIELD_ENCRYPTION_KEY=replace-with-64-char-random-hex-different-from-jwt

# CORS — no trailing slash
CORS_ORIGINS=http://localhost:3000,https://kartavaya.com,https://www.kartavaya.com
FRONTEND_URL=https://kartavaya.com

# Web Push
VAPID_SUBJECT=mailto:admin@aekaminc.com

# Email — AWS SES (no-reply@aekaminc.com is verified on SES)
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
FROM_EMAIL=Kartavaya <no-reply@aekaminc.com>

# Cookie security
COOKIE_SECURE=true
