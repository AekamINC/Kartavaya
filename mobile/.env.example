# Copy this file to .env and fill in values
# Never commit .env to version control

# Backend API base URL (no trailing slash)
#
# Default to STAGING. Staging and production share one Supabase database, so a
# dev build pointed at production writes real rows against real customer data.
# Point this at production only when you specifically mean to.
#
# Staging:    https://kartavya-staging.up.railway.app
# Production: https://kartavya-production.up.railway.app
# Future domain: https://api.kartavaya.aekaminc.com
EXPO_PUBLIC_API_URL=https://kartavya-staging.up.railway.app
