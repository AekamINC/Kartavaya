# Copy this file to .env and fill in values
# Never commit .env to version control

# Backend API base URL (no trailing slash)
#
# ⚠ THERE IS NO STAGING. One environment, one database, one branch (`main`).
# Everything was moved to production on 2026-08-30. Use api.kartavaya.com — a
# name we own, so it survives a Railway service rename (that has already
# happened once and shipped an APK pointing at a dead host).
#
# Every row this client writes is a real row in the live product, next to real
# customers. There is no safe host to develop against.
EXPO_PUBLIC_API_URL=https://api.kartavaya.com
