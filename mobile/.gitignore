node_modules/
.expo/
dist/
npm-debug.*

# Native projects are generated by CNG from app.json — never committed.
# `expo prebuild` / `expo run:android` recreate them, and eas.json sets
# requireCommit, so leaving them untracked would block every build.
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Environment variables — never commit secrets. `.env*` rather than a list:
# `.env.bak` sat here holding real staging JWTs, saved from a commit only by a
# corrupted block in the ROOT .gitignore — this file's list simply missed it.
# Ignoring locally what the root also ignores means one cleanup up there can
# never expose a secret down here. `.env.example` is the committed template
# and is re-included.
.env*
!.env.example

# Google service account key
google-service-account.json

# macOS
.DS_Store
