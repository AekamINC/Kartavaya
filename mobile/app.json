{
  "expo": {
    "name": "Kartavaya",
    "slug": "kartavya",
    "scheme": "kartavaya",
    "version": "2.0.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E11"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.aekaminc.Kartavaya",
      "infoPlist": {
        "NSCameraUsageDescription": "Take the selfie that records your clock in and clock out, and capture site photos and receipts to attach to tasks. Attendance photos are visible only to your HR team and your reporting manager.",
        "NSMicrophoneUsageDescription": "Record voice notes that turn into task comments.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to tasks. Attendance selfies are always taken with the camera and can never come from your library.",
        "NSLocationWhenInUseUsageDescription": "Record where you clocked in and out, so your attendance can be confirmed against your site. Your location is read at the moment you punch and at no other time.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aekaminc.Kartavaya",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04837A"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#05b7aa",
          "defaultChannel": "default",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kartavaya to attach photos to tasks.",
          "cameraPermission": "Allow Kartavaya to capture photos for tasks."
        }
      ],
      "expo-document-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "196c2be9-caab-49a6-a359-a2adbfc6d821"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/196c2be9-caab-49a6-a359-a2adbfc6d821",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "owner": "aekaminc"
  }
}
