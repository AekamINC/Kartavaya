# Scripts / local utilities — root only. A bare `scripts/` matches at any depth,
# which also swallowed frontend/scripts/, where the CI checks live.
# `/scripts/*`, not `/scripts/` — git does not re-include a file whose PARENT
# DIRECTORY is excluded, so a negation under a bare `/scripts/` is silently
# inert. Excluding the contents instead is what makes the two exceptions below
# actually take effect; verified with `git check-ignore`.
/scripts/*
# ...EXCEPT the two module-doc generators. CLAUDE.md tells people that
# `docs/modules/*.md` are generated by these and must be regenerated rather than
# hand-edited — an instruction nobody could follow from a clean clone while they
# sat outside version control. They read source and write docs; they hold no
# credentials. The rest of scripts/ stays local.
!/scripts/module-facts.mjs
!/scripts/gen-module-docs.mjs

# Mobile development
android-sdk/

# Environment files — ONE copy of this block. A bad `echo -e` once appended it
# four times with literal "-e " pattern lines between the copies, and glued
# `android-sdk/` to a pack-file path on a single line so neither matched. The
# secrets (.env, .env.bak, .env.local, timestamped .env.bak-*) all hung off
# this one corrupted block; keep it boring. The committed *.env.example
# templates are re-included — they are documentation, not secrets.
*.env
*.env.*
!*.env.example

.claude/worktrees/

# Local DB snapshots — contain user and org IDs, never committed
.backups/

# Rendered email previews — the harness is committed, its output is not.
backend/scripts/_email_preview/

# Document harness output — regenerate with backend/scripts/render_documents.py
backend/.doc-harness/

# Design mockups staged for side-by-side comparison (see swarm-reports/_DESIGN-GAP.md).
# Copied from design-reference/ at need; never committed, so the reference stays
# single-source.
frontend/public/__ref/

# Measurement harness for the reference-vs-build comparison. Local only —
# the reference stays single-source in design-reference/.
frontend/__probe.html
frontend/src/__probe.jsx
frontend/public/__diff.htm
frontend/public/__meas.js
frontend/public/__pairs.js
frontend/public/__runref.js
frontend/public/__runbuild.js

# Playwright run artifacts — screenshots, traces and error contexts written on
# failure. Useful locally, never a repo asset: they are large, binary, and
# regenerated by the next run.
/test-results/
/playwright-report/
frontend/test-results/
frontend/playwright-report/

# `scripts/visual-baseline.mjs` states in its header that "`visual-baselines/`
# is gitignored. If you find PNGs in a diff, something has gone wrong." It was
# not, and had never been — the pattern simply did not exist. Nothing had leaked
# only because nobody had run the script since. Added 2026-08-30.
visual-baselines/
frontend/visual-baselines/
module-facts.json

# Firebase / Google service-account private keys. NEVER commit these.
# `google-services.json` IS committed on purpose — it ships inside the APK and
# its API key is restricted to the package name, so it is not a secret. The
# ADMIN SDK key is the opposite: it can send push and read the whole project,
# and it belongs only in `eas credentials`.
**/*-adminsdk-*.json
**/service-account*.json
**/google-service-account.json
mobile/apk-build.log
backend/.coverage
backend/coverage.xml

# PIN code boundary shards — 18.5MB of government reference data that lives in
# R2 (`aekaminc/shared/reference/pincode-boundaries/`), never in git. Rebuild a
# local copy with backend/scripts/prepare_pincode_boundaries.py.
backend/data/pincode_boundaries/

# Rendered marketing PDFs. Build outputs, not sources: `build-pdf.mjs`
# regenerates all fourteen from `module-flows.html` + `fonts.css`, and every
# rebuild rewrites all of them with different bytes — ~2.9MB added to a PUBLIC
# repo's history per edit, for files git cannot diff. The source and the fonts
# ARE committed, so anyone can reproduce them exactly:
#     node docs/marketing/build-pdf.mjs
docs/marketing/pdf/
