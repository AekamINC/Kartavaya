<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch screen's ground.

      #F3EFE6 is var(bg), the same value index.html declares as its background and
      manifest.json as `background_color`. Capacitor's stock splash used
      #EBEDF5, a grey-blue belonging to no part of this product, so the app
      opened on one colour and then snapped to another the moment the web layer
      painted. Matching them means the splash dissolves into the app instead of
      cutting to it.

      Literal because it has to be: Android resolves these before any JavaScript
      runs, so the launch screen cannot read a CSS custom property or follow the
      user's chosen accent. This is the only place in the product where the
      brand colours are written out, and it is the one place they cannot be
      tokens.
    -->
    <color name="brandSplashBackground">#F3EFE6</color>

    <!-- Referenced by AppTheme in styles.xml, which shipped pointing at colour
         resources that were never defined in this project. -->
    <color name="colorPrimary">#04837A</color>
    <color name="colorPrimaryDark">#036A63</color>
    <color name="colorAccent">#04837A</color>
</resources>
