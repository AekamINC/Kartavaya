<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Pahchan's clock-in: a selfie and where it was taken. The web layer asks
      for both with the plain browser APIs — `navigator.mediaDevices.getUserMedia`
      and `navigator.geolocation` — and Capacitor's BridgeWebChromeClient already
      answers the WebView's prompts for them (`onPermissionRequest` and
      `onGeolocationPermissionsShowPrompt`), requesting CAMERA and the two
      location permissions at runtime.

      It cannot request what is not declared here. An undeclared runtime
      permission is refused by the framework immediately, WITHOUT showing the
      person a dialog — so the camera never opens and the punch never finds a
      location, and neither failure says why. Declaring them is what makes
      Capacitor's existing handling reachable.

      RECORD_AUDIO is deliberately absent: both getUserMedia calls pass
      `audio: false` (Clock.jsx, Enroll.jsx), so the microphone is never opened
      and asking for it would claim a capability the app does not use.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Not required: a tablet without a camera should still install and run every
      other module. Without this, Play treats CAMERA as an implicit hardware
      requirement and hides the app from those devices.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
