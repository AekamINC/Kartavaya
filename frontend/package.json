{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@samasante/liquid-glass": "^0.1.1",
    "@supabase/supabase-js": "^2.106.1",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "apk": "npm run build:staging && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/__tests__/e2e",
    "check": "node scripts/check-csp-hash.mjs && node scripts/check-one-index-html.mjs && node scripts/check-css-parses.mjs && node scripts/check-tokens.mjs && node scripts/check-motion.mjs && node scripts/check-orphan-keyframes.mjs && node scripts/check-mount-motion.mjs && node scripts/check-classes.mjs && node scripts/check-orphan-selectors.mjs && node scripts/check-class-collisions.mjs && node scripts/check-contrast.mjs && node scripts/check-write-gates.mjs && node scripts/check-table-rows.mjs && node scripts/check-rendered-ids.mjs && node scripts/check-mappls-attribution.mjs && node scripts/check-dateinput-handlers.mjs && node scripts/check-e2e-no-bypass.mjs && node scripts/check-touch-targets.mjs && node scripts/check-accent-contrast.mjs && node scripts/check-ci-runs-every-gate.mjs",
    "check:csp": "node scripts/check-csp-hash.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:keyframes": "node scripts/check-orphan-keyframes.mjs",
    "check:keyframes:write": "node scripts/check-orphan-keyframes.mjs --write",
    "check:classes": "node scripts/check-classes.mjs",
    "check:orphans": "node scripts/check-orphan-selectors.mjs",
    "check:orphans:write": "node scripts/check-orphan-selectors.mjs --write",
    "check:tables": "node scripts/check-table-rows.mjs && node scripts/check-rendered-ids.mjs",
    "check:gates": "node scripts/check-write-gates.mjs",
    "test:e2e:gating": "playwright test",
    "test:browsers:install": "playwright install firefox webkit",
    "test:xbrowser": "playwright test"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
