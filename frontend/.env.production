VITE_BACKEND_URL=https://kartavaya-production.up.railway.app

# Where the landing page's "Request a demo" button goes.
#
# Without this, `pages/marketing/cta.js` hides the button and shows the
# invite-only note instead — deliberately, because the product has no public
# signup and pointing the CTA at /login strands visitors on a password field
# for an account they do not have.
#
# TEST NUMBER, not the business line. +44 7405 382925 is the owner's own
# number, set so the WhatsApp path can be exercised end to end before a
# business account exists. `wa.me` takes the number with no +, spaces or
# dashes.
#
# SWAP THIS before the landing page is advertised anywhere. A public CTA
# pointing at a personal UK mobile is fine for a staging walkthrough and wrong
# for Indian accounting firms arriving from a marketing link. The previous
# value, `mailto:hello@aekaminc.com`, is the safe fallback if the business
# number is not ready in time.
VITE_LEAD_CTA_HREF=https://wa.me/447405382925

# The invoice host. `payLink()` in `pages/ganit/_shared.jsx` falls back to
# `window.location.origin` when this is unset — which, for staff working inside
# the product, meant every copied invoice link read `app.kartavaya.com/i/<token>`
# and was sent to a customer on the app's origin. That is the one thing
# `pay.` exists to prevent: `email_service.py:25` keeps the invoice on its own
# host so it "can never be mistaken for a session".
#
# Emailed invoices were never wrong — those come from the backend's PAY_URL
# (`services/invoice_email.py:53`). This fixes the in-app copy/share button.
#
# Deliberately NOT set in .env.development: on localhost the fallback is
# correct, because this origin is the only host that can serve the link.
VITE_PAY_BASE_URL=https://pay.kartavaya.com
