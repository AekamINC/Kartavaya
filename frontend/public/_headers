# Cloudflare Pages headers — the _headers half of docs/CLOUDFLARE-MIGRATION.md W2.
#
# INERT ON VERCEL. Vite copies public/* into dist/ verbatim and Vercel ignores
# a file named _headers, so this ships ahead of the cutover at zero risk. It
# becomes live the moment a Pages project serves this build.
#
# Mirrors frontend/vercel.json with exactly three deliberate differences:
#   1. staging.kartavya.com corrected to staging.kartavaya.com (the misspelling
#      allowed a domain nobody owns and omitted the one we do).
#   2. va.vercel-scripts.com / vitals.vercel-insights.com swapped for the
#      Cloudflare Web Analytics pair — PAIRED WITH the S3 code swap in
#      src/index.jsx (inject() -> beacon); do not land one without the other.
#   3. Order inverted: Cloudflare applies the LAST matching rule per header,
#      so the catch-all comes first and the specific caches override after.

/*
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-JtAu+6V2X/sONIJ0daMfltBe8H1N8hZ9kn7S9IFO4hk=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://rsms.me; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://rsms.me; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://rsms.me; connect-src 'self' https://kartavya-production.up.railway.app https://kartavya-staging.up.railway.app https://kartavaya.com https://www.kartavaya.com https://staging.kartavaya.com https://toacecaewujfxjfrjwco.supabase.co wss://toacecaewujfxjfrjwco.supabase.co wss://realtime.toacecaewujfxjfrjwco.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com https://cloudflareinsights.com https://*.r2.cloudflarestorage.com; frame-src https://view.officeapps.live.com https://docs.google.com https://*.r2.cloudflarestorage.com https://*.r2.dev https:; object-src 'none'; frame-ancestors 'none';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
